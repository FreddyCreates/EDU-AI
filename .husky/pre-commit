#!/bin/sh
# PROTECTION SYSTEM - PRE-COMMIT HOOK
# Blocks any commit that deletes files from protected deployed paths
# Install: npx husky install && chmod +x .husky/pre-commit

PROTECTED_PATHS="src/frontend/dist/ dist/ build/"

# Get list of deleted files staged for commit
DELETED_FILES=$(git diff --cached --name-status | grep "^D" || true)

VIOLATIONS=""
for path in $PROTECTED_PATHS; do
  FOUND=$(echo "$DELETED_FILES" | grep "$path" || true)
  if [ -n "$FOUND" ]; then
    VIOLATIONS="$VIOLATIONS\n$FOUND"
  fi
done

if [ -n "$VIOLATIONS" ]; then
  echo ""
  echo "============================================"
  echo "🚫 COMMIT BLOCKED - PROTECTION SYSTEM"
  echo "============================================"
  echo ""
  echo "You are attempting to DELETE protected files:"
  echo "$VIOLATIONS"
  echo ""
  echo "PROTECTED PATHS:"
  echo "  - src/frontend/dist/"
  echo "  - dist/"
  echo "  - build/"
  echo ""
  echo "These contain DEPLOYED production code."
  echo "DELETION IS NOT PERMITTED."
  echo ""
  echo "To update deployed files:"
  echo "  1. Make your source changes"
  echo "  2. Run: npm run build"
  echo "  3. Commit the new build output"
  echo ""
  echo "============================================"
  exit 1
fi

exit 0
