---
const links = [
  { href: '/', label: 'Home' },
  { href: '/intelligence', label: 'Intelligence' },
  { href: '/portals', label: 'Portals' },
];
const currentPath = Astro.url.pathname;
---
<nav class="glass-nav fixed top-0 left-0 right-0 z-50">
  <div class="max-w-6xl mx-auto px-fib-2xl h-[55px] flex items-center justify-between">
    <a href="/" class="flex items-center gap-fib-md">
      <div class="w-8 h-8 rounded-full" style="background: radial-gradient(circle at 35% 35%, oklch(0.76 0.18 84), oklch(0.72 0.17 155)); box-shadow: 0 0 13px oklch(0.76 0.18 84 / 0.5);"></div>
      <span class="font-display font-semibold text-[17px]" style="color: var(--text-primary);">EDU-AI</span>
    </a>
    <div class="hidden md:flex items-center gap-fib-xl">
      {links.map(link => (
        <a
          href={link.href}
          class={`text-[14px] font-medium transition-colors ${
            currentPath === link.href
              ? 'text-gold'
              : 'hover:text-gold'
          }`}
          style={currentPath === link.href
            ? 'color: var(--color-gold);'
            : 'color: var(--text-secondary);'}
        >
          {link.label}
        </a>
      ))}
    </div>
    <a
      href="https://app.edu-ai.icp"
      class="glass-grade-vault px-fib-lg py-fib-md text-[13px] font-semibold transition-all hover:opacity-90"
      style="color: var(--color-gold);"
    >
      Launch App →
    </a>
  </div>
</nav>
