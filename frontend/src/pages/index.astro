---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import GlassCard from '../components/GlassCard.astro';
import PortalCard from '../components/PortalCard.astro';

const portals = [
  {
    name: 'Student Portal',
    role: 'Learner',
    tagline: 'Deep reasoning chat, scaffold support, self-study tracking, and feedback loops — all powered by ADEDDI.',
    variant: 'teal' as const,
    engines: ['EDDI', 'COGT', 'META', 'MEMORIA-VIVA'],
  },
  {
    name: 'Teacher Portal',
    role: 'Educator',
    tagline: 'Protocol management, AI assessment, class recognition, and sovereign feedback authoring.',
    variant: 'gold' as const,
    engines: ['SKAI_DOCENS', 'CRITERIOS', 'HERALD', 'PRAXIS'],
  },
  {
    name: 'Principal Portal',
    role: 'Leader',
    tagline: 'School-wide intelligence: catalog vision, recognition events, silver builders, and field health.',
    variant: 'gold' as const,
    engines: ['NEXUS', 'KAIROS', 'AURUM', 'VEKTOR'],
  },
  {
    name: 'IT Portal',
    role: 'Infrastructure',
    tagline: 'Substrate monitoring, EDDI OS console, deep system diagnostics, and vault management.',
    variant: 'teal' as const,
    engines: ['EDDI-OS', 'FIELD-MONITOR', 'KRONOS', 'TESSERA'],
  },
];
---
<Base title="Sovereign K-12 Intelligence">
  <Nav />
  <main class="pt-[55px]">

    <!-- ── Hero ─────────────────────────────────────────────────── -->
    <section class="min-h-screen flex flex-col items-center justify-center px-fib-2xl text-center relative overflow-hidden">
      <!-- Background radial glow -->
      <div class="absolute inset-0 pointer-events-none" style="background: radial-gradient(ellipse 60% 50% at 50% 40%, oklch(0.76 0.18 84 / 0.06) 0%, transparent 70%), radial-gradient(ellipse 40% 40% at 50% 60%, oklch(0.72 0.17 155 / 0.05) 0%, transparent 70%);"></div>

      <!-- EDDI Orb -->
      <div class="relative mb-fib-3xl">
        <div class="w-32 h-32 rounded-full mx-auto relative" style="background: radial-gradient(circle at 35% 35%, oklch(0.76 0.18 84 / 0.9), oklch(0.72 0.17 155 / 0.7), oklch(0.07 0.01 260)); box-shadow: 0 0 55px oklch(0.76 0.18 84 / 0.3), 0 0 89px oklch(0.72 0.17 155 / 0.2), inset 0 1px 0 rgba(255,255,255,0.25);">
          <div class="absolute inset-0 rounded-full" style="background: radial-gradient(circle at 30% 30%, rgba(255,255,255,0.15), transparent 60%);"></div>
        </div>
        <!-- Orbit ring -->
        <div class="absolute inset-0 rounded-full border" style="border-color: oklch(0.76 0.18 84 / 0.2); transform: scale(1.3); animation: spin 20s linear infinite;"></div>
      </div>

      <h1 class="text-[48px] md:text-[68px] font-display font-bold leading-none tracking-tight mb-fib-xl" style="color: var(--text-primary);">
        Sovereign<br/>
        <span style="color: var(--color-gold);">K-12 Intelligence</span>
      </h1>

      <p class="text-[17px] md:text-[20px] max-w-2xl mb-fib-2xl leading-relaxed" style="color: var(--text-secondary);">
        EDU-AI runs fully on-chain on the Internet Computer. No external APIs. No data leaks.
        The ADEDDI 7-layer reasoning engine powers every student interaction — natively.
      </p>

      <div class="flex flex-col sm:flex-row gap-fib-lg">
        <a href="/intelligence" class="glass-grade-vault px-fib-2xl py-fib-lg text-[15px] font-semibold transition-all hover:opacity-90" style="color: var(--color-gold);">
          Explore ADEDDI Intelligence →
        </a>
        <a href="/portals" class="glass-knowledge-surface px-fib-2xl py-fib-lg text-[15px] font-semibold transition-all hover:opacity-90" style="color: var(--color-teal);">
          View All Portals
        </a>
      </div>

      <!-- Floating stat pills -->
      <div class="flex flex-wrap justify-center gap-fib-lg mt-fib-3xl">
        {['7-Layer Reasoning', '19 Sovereign Engines', 'Fully On-Chain ICP', 'Zero External AI', 'PHI-Grid Architecture', 'SCRIPTORIUM-REX Vault'].map(stat => (
          <span class="glass-surface px-fib-lg py-fib-md text-[12px] font-mono" style="color: var(--text-tertiary);">{stat}</span>
        ))}
      </div>
    </section>

    <!-- ── Portals Grid ──────────────────────────────────────────── -->
    <section class="max-w-6xl mx-auto px-fib-2xl py-fib-3xl">
      <div class="text-center mb-fib-3xl">
        <span class="text-[11px] font-mono uppercase tracking-widest" style="color: var(--color-teal);">Four Portals. One Organism.</span>
        <h2 class="text-[36px] font-display font-bold mt-fib-md" style="color: var(--text-primary);">Every Role, Sovereign</h2>
        <p class="text-[15px] mt-fib-lg max-w-xl mx-auto" style="color: var(--text-secondary);">
          From the student deep-reasoning chat to the IT substrate monitor — each portal runs its own sovereign engine mix, all coordinated by ADEDDI.
        </p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-fib-xl">
        {portals.map(p => (
          <PortalCard {...p} />
        ))}
      </div>
    </section>

    <!-- ── ADEDDI teaser ──────────────────────────────────────────── -->
    <section class="max-w-6xl mx-auto px-fib-2xl pb-fib-3xl">
      <GlassCard variant="gold" class="text-center">
        <span class="text-[11px] font-mono uppercase tracking-widest" style="color: var(--color-gold);">Alpha Deep EDDI</span>
        <h2 class="text-[28px] font-display font-bold mt-fib-md mb-fib-lg" style="color: var(--text-primary);">The Only Internal Big Model in K-12</h2>
        <p class="text-[15px] max-w-2xl mx-auto mb-fib-2xl" style="color: var(--text-secondary);">
          ADEDDI runs 7 sequential reasoning layers — COGT (cognitive chain), META (Architecture Council synthesis), and AUTN (PHI-entropy autonomous insight) — on every single query. No hallucinations. No third-party calls. Doctrine artifacts crystallised on-chain after every session.
        </p>
        <a href="/intelligence" class="inline-block glass-grade-vault px-fib-2xl py-fib-lg text-[14px] font-semibold" style="color: var(--color-gold);">
          See the 7-Layer Chain →
        </a>
      </GlassCard>
    </section>

    <!-- ── Footer ──────────────────────────────────────────────────── -->
    <footer class="border-t border-white/5 py-fib-3xl px-fib-2xl text-center">
      <p class="text-[12px] font-mono" style="color: var(--text-disabled);">
        EDU-AI · Sovereign K-12 Intelligence · Built on ICP · LEX_SOVEREIGNUS
      </p>
    </footer>
  </main>

  <style>
    @keyframes spin {
      from { transform: scale(1.3) rotate(0deg); }
      to   { transform: scale(1.3) rotate(360deg); }
    }
  </style>
</Base>
