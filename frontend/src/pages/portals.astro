---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import PortalCard from '../components/PortalCard.astro';
import GlassCard from '../components/GlassCard.astro';

const base = import.meta.env.BASE_URL || '/EDU-AI';

// All 7 Portals
const portals = [
  {
    name: 'Student Portal',
    role: 'For Students',
    tagline: 'Your personal learning space. Chat with EDDI for instant help, take adaptive quizzes, track your mastery, browse all subjects, and build your Learning Passport over time.',
    variant: 'teal' as const,
    features: ['EDDI Chat', 'Adaptive Quizzes', 'Mastery Tracking', 'Learning Passport', 'Subject Browser', 'Study Streaks'],
  },
  {
    name: 'Teacher Portal',
    role: 'For Educators',
    tagline: 'Build lessons with SKAI_DOCENS, grade with AI assistance, monitor every student in real-time, create protocols, and deliver targeted feedback that actually helps.',
    variant: 'gold' as const,
    features: ['Lesson Builder', 'AI Grading', 'Class Analytics', 'Protocol Creator', 'Feedback Tools', 'Standards Alignment'],
  },
  {
    name: 'Principal Portal',
    role: 'For School Leaders',
    tagline: 'See your entire school at a glance. Performance heatmaps, recognition events, curriculum vision, funding intelligence, and data-driven insights for every decision.',
    variant: 'gold' as const,
    features: ['School Heatmap', 'Recognition Events', 'Catalog Vision', 'Funding Intelligence', 'Staff Overview', 'Goal Tracking'],
  },
  {
    name: 'IT Portal',
    role: 'For System Admins',
    tagline: 'Full control over EDU-AI infrastructure. EDDI OS console, system diagnostics, user management, privacy controls, audit logs, and integration management.',
    variant: 'teal' as const,
    features: ['EDDI OS Console', 'System Diagnostics', 'User Management', 'Privacy Controls', 'Audit Logs', 'Integrations'],
  },
  {
    name: 'Parent Portal',
    role: 'For Families',
    tagline: 'Stay connected to your child\'s learning journey. See progress updates, mastery growth, teacher feedback, and upcoming assignments — all in one place.',
    variant: 'teal' as const,
    features: ['Progress Updates', 'Mastery View', 'Teacher Messages', 'Assignment Calendar', 'Recognition Alerts'],
  },
  {
    name: 'Counselor Portal',
    role: 'For Guidance',
    tagline: 'Support student wellbeing and academic planning. Track IEPs, monitor mental health check-ins, manage caseloads, and coordinate with teachers and families.',
    variant: 'teal' as const,
    features: ['IEP Tracking', 'Wellness Check-ins', 'Caseload Manager', 'College Prep', 'Crisis Alerts'],
  },
  {
    name: 'District Portal',
    role: 'For District Leaders',
    tagline: 'Oversee all schools in your district. Aggregate analytics, cross-school comparisons, curriculum standardization, budget tracking, and compliance reporting.',
    variant: 'gold' as const,
    features: ['District Dashboard', 'School Comparison', 'Curriculum Standards', 'Budget Tracking', 'Compliance Reports'],
  },
];
---
<Base title="Portals — EDU-AI" description="7 dedicated portals for Students, Teachers, Principals, IT, Parents, Counselors, and Districts — all powered by EDDI.">
  <Nav />
  <main class="pt-[55px]">

    <section class="max-w-4xl mx-auto px-fib-2xl pt-fib-3xl pb-fib-2xl text-center">
      <span class="text-[11px] font-mono uppercase tracking-widest" style="color: var(--color-teal);">7 Portals · One Platform</span>
      <h1 class="text-[40px] md:text-[52px] font-display font-bold mt-fib-md mb-fib-lg" style="color: var(--text-primary);">
        Choose Your <span style="color: var(--color-teal);">Portal</span>
      </h1>
      <p class="text-[16px] max-w-2xl mx-auto" style="color: var(--text-secondary);">
        Every person in your school ecosystem has a dedicated experience. Students learn, teachers teach, 
        principals lead, IT keeps it running, parents stay informed, counselors support, and districts oversee — 
        all powered by EDDI.
      </p>
    </section>

    <!-- Main 4 Portals -->
    <section class="max-w-6xl mx-auto px-fib-2xl pb-fib-2xl">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-fib-xl">
        {portals.slice(0, 4).map(p => <PortalCard {...p} />)}
      </div>
    </section>

    <!-- Additional 3 Portals -->
    <section class="max-w-6xl mx-auto px-fib-2xl pb-fib-3xl">
      <div class="text-center mb-fib-xl">
        <span class="text-[11px] font-mono uppercase tracking-widest" style="color: var(--color-gold);">Extended Ecosystem</span>
        <h2 class="text-[24px] font-display font-bold mt-fib-md" style="color: var(--text-primary);">Plus 3 More Portals</h2>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-fib-xl">
        {portals.slice(4).map(p => <PortalCard {...p} />)}
      </div>
    </section>

    <!-- Architecture Summary -->
    <section class="max-w-6xl mx-auto px-fib-2xl pb-fib-3xl">
      <GlassCard variant="teal" class="text-center">
        <span class="text-[11px] font-mono uppercase tracking-widest" style="color: var(--color-teal);">Sovereign Architecture</span>
        <h2 class="text-[24px] font-display font-bold mt-fib-md mb-fib-lg" style="color: var(--text-primary);">All Portals, One Intelligence</h2>
        <p class="text-[14px] max-w-2xl mx-auto mb-fib-xl" style="color: var(--text-secondary);">
          Every portal shares the same EDDI intelligence core. When a student learns, teachers see it. 
          When teachers grade, parents are notified. When principals set goals, the whole school tracks progress. 
          One platform, fully connected, completely private.
        </p>
        <div class="flex flex-wrap justify-center gap-fib-md">
          {['Real-Time Sync', 'Sovereign Data', 'No External AI', 'COPPA Compliant', 'FERPA Ready', 'Mobile + Desktop'].map(tag => (
            <span class="glass-surface px-fib-lg py-fib-md text-[11px] font-mono" style="color: var(--text-tertiary);">{tag}</span>
          ))}
        </div>
      </GlassCard>
    </section>

    <!-- Grade Levels -->
    <section class="max-w-6xl mx-auto px-fib-2xl pb-fib-3xl">
      <div class="text-center mb-fib-2xl">
        <span class="text-[11px] font-mono uppercase tracking-widest" style="color: var(--color-gold);">K-12 Coverage</span>
        <h2 class="text-[28px] font-display font-bold mt-fib-md" style="color: var(--text-primary);">Every Grade, Every Subject</h2>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-fib-lg">
        {[
          { grades: 'K-2', label: 'Early Elementary', desc: 'Foundational literacy, numeracy, and curiosity' },
          { grades: '3-5', label: 'Upper Elementary', desc: 'Building knowledge across core subjects' },
          { grades: '6-8', label: 'Middle School', desc: 'Critical thinking and deeper exploration' },
          { grades: '9-12', label: 'High School', desc: 'Advanced subjects and college prep' },
        ].map(g => (
          <div class="glass-grade-vault p-fib-xl text-center">
            <p class="text-[28px] font-display font-bold" style="color: var(--color-gold);">{g.grades}</p>
            <p class="text-[12px] font-semibold mb-fib-xs" style="color: var(--text-primary);">{g.label}</p>
            <p class="text-[11px]" style="color: var(--text-tertiary);">{g.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- CTA -->
    <section class="max-w-4xl mx-auto px-fib-2xl pb-fib-3xl text-center">
      <h2 class="text-[28px] font-display font-bold mb-fib-lg" style="color: var(--text-primary);">Ready to Transform Your School?</h2>
      <p class="text-[15px] mb-fib-2xl" style="color: var(--text-secondary);">
        EDDI is waiting to meet your students, teachers, and staff. Let's get started.
      </p>
      <a href={`${base}/intelligence`} class="inline-block glass-grade-vault px-fib-2xl py-fib-lg text-[14px] font-semibold" style="color: var(--color-gold);">
        See How EDDI Works →
      </a>
    </section>

    <footer class="border-t border-white/5 py-fib-3xl px-fib-2xl text-center">
      <p class="text-[12px] font-mono" style="color: var(--text-disabled);">
        EDU-AI · Educational Deep Dialogue Intelligence · 7 Portals, One EDDI
      </p>
    </footer>
  </main>
</Base>
