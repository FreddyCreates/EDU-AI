service : {
  addAdmissionsEvent: (event: AdmissionsEvent) -> (bool);
  addCalendarEvent: (event: CalendarEvent) -> ();
  addCollegeToList: (entry: CollegeEntry) -> (bool);
  addCounselorMilestone: (studentPrincipal: principal, milestone:
   CounselorMilestone) -> (bool);
  addFieldTripAttendee: (tripId: nat, p: principal) -> ();
  addGroupMember: (groupId: nat, member: principal) -> (bool);
  addScholarshipProgram: (program: ScholarshipProgram) -> (nat);
  addSchoolToDistrict: (districtId: DistrictId, schoolId: SchoolId) -> (bool);
  addStaffMember: (id: text, name: text, role: StaffRole, dept: text, level:
   nat) -> (bool);
  addSubHandoffNote: (subRecordId: nat, note: text) -> ();
  advanceTrackStep: (trackId: TrackId, artifactName: opt text, now: int) ->
   (variant {
      err: text;
      ok: TrackEnrollment;
    });
  alignContent: (alignment: StandardAlignment) -> ();
  approveClient: (requestId: text, apiKey: text) -> (opt RegistrationResult);
  archiveTripToPassport: (tripId: nat) -> ();
  askAgent: (agentRole: text, userMessage: text, topic: text, subject: 
   text, gradeLevel: text, messageIndex: nat) -> (text);
  autoSealFromSession: (sessionSummary: text, engineUsed: text, subject:
   text, gradeLevel: text) -> (text);
  chatWithEddi: (mode: EDDIMode, message: text, sessionId: text) ->
   (record {
      modeUsed: EDDIMode;
      nextModeSuggestion: opt EDDIMode;
      response: text;
    });
  checkGradeAccess: (studentGrade: nat, contentGrade: nat) ->
   (GradeGate) query;
  checkOutResource: (resourceType: ResourceType, resourceId: text, title:
   text, dueDate: opt int) -> (nat);
  completeModule: (courseId: text, moduleIndex: nat) ->
   (variant {
      err: text;
      ok: text;
    });
  completeSelfStudyMilestone: (trackId: text, milestoneIndex: nat) -> (bool);
  completeTestPrepSession: (sessionId: nat, correct: nat, attempted: 
   nat, completedAt: int) -> (bool);
  completeTrack: (trackId: TrackId, artifactName: opt text, now: int) ->
   (variant {
      err: text;
      ok: TrackEnrollment;
    });
  completeTutoringSession: (sessionId: nat, masteryDeltaAfter: nat,
   transcriptHash: opt blob) -> (bool);
  computeCareerRecommendations: (passportMastery: vec record {
                                                        nat;
                                                        nat;
                                                      }) ->
   (vec CareerCluster);
  computeIAS: (sssScore: nat, cohScore: nat) -> (IasResult) query;
  computeImpact: (schoolCount: nat, studentsPerSchool: nat) ->
   (ImpactResult) query;
  computeScoreProjection: (mode: TestPrepMode, computedAt: int) ->
   (ScoreProjection);
  computeStudentState: (sssPrev: nat) -> (LiveIntelligenceState) query;
  createAgent: (name: text, modeBinding: EDDIMode, reasoningSeed: text,
   memoryConfig: text) -> (UserAgent);
  createAssignment: (assignment: Assignment) -> (nat);
  createClass: (teacherId: text, name: text, subject: text, gradeLevel: 
   nat, studentIds: vec text) -> (bool);
  createClub: (name: text, category: ClubCategory, schoolId: nat) -> (nat);
  createCounselorPlan: (plan: CounselorPlan) -> ();
  createDistrict: (name: text, state: text, contactEmail: text, createdAt:
   int) -> (DistrictId);
  createFactoryStudent: (username: text, gradeLevel: text) ->
   (variant {
      err: text;
      ok: text;
    });
  createFieldTrip: (title: text, schoolId: nat, gradeLevel: nat,
   activityDate: int, location: text, enrichmentType: EnrichmentType) ->
   (nat);
  createSelfStudyTrack: (title: text, category: text, competitionDate:
   int) -> (text);
  createSovereignPassport: (studentName: text, gradeLevel: text, collegium:
   text) -> (SovereignPassport);
  createStudentProfile: (name: text, gradeLevel: text) -> (StudentProfile);
  createSubRecord: (coveringTeacherPrincipal: principal, classCode: text,
   date: int, accessLevel: SubAccessLevel) -> (nat);
  createTutoringSession: (session: TutoringSession) -> (nat);
  deactivateAccommodations: (studentPrincipal: principal) -> (bool);
  diagSystem: () ->
   (record {
      avgCoh: float64;
      errors: vec text;
      heartbeatCount: nat;
      pilScore: float64;
      status: variant {
                muta;
                ok;
              };
    }) query;
  digestCurriculumText: (title: text, gradeLevel: nat, subject: text,
   rawText: text, teacherId: text) -> (DigestResult);
  digestTextbook: (title: text, gradeLevel: nat, subject: text, rawText:
   text) -> (DigtDigestResult);
  dissolveClub: (clubId: nat) -> ();
  dissolveStudyGroup: (groupId: nat) -> (bool);
  drainVaultBuffer: () -> (vec blob);
  enrollInCourse: (courseId: text) -> (variant {
                                         err: text;
                                         ok;
                                       });
  enrollInCourseWithStart: (courseId: text) -> (EnrollmentResult);
  enrollInTrack: (trackId: TrackId, now: int) ->
   (variant {
      err: text;
      ok: TrackEnrollment;
    });
  enterNexumGate: (collegium: text, now: int) -> (NexumGateEntry);
  executeQuery: (target: text, filters: vec record {
                                              text;
                                              text;
                                              text;
                                            }, limit: nat) -> (QueryResult);
  factoryAdminSetup: (adminName: text) -> (variant {
                                             err: text;
                                             ok: text;
                                           });
  factoryStatus: () ->
   (record {
      adminExists: bool;
      factoryLocked: bool;
      studentCount: nat;
    }) query;
  fireArchCouncil: (queryText: text, domain: text) -> (MLTVResponse);
  flagStudentIep: (studentPrincipal: principal) -> (bool);
  formStudyGroup: (subjectId: nat, gradeLevel: nat, memberPrincipals:
   vec principal, sssLow: nat, sssHigh: nat) -> (nat);
  generateClassHeatmap: (classId: text) -> (opt ClassHeatmap) query;
  generateTeacherRecommendations: (classId: text) ->
   (vec TeacherRecommendation);
  generateVisionDocument: () -> (VisionDocument) query;
  getAccessibleContent: (studentGrade: nat) -> (vec GradeVaultEntry) query;
  getAccommodations: (studentPrincipal: principal) ->
   (opt IepAccommodation) query;
  getAchievementGaps: (districtId: DistrictId) ->
   (vec AchievementGapRecord) query;
  getAchievementTimeline: (studentId: UserId) ->
   (vec AchievementTimelineEntry) query;
  getAchievements: (studentId: UserId) -> (vec AchievementRecord) query;
  getAdaptiveSuggestion: (subjectId: text) -> (AdaptiveSuggestion) query;
  getAdaptiveWorkflow: (subjectId: text, gradeLevel: text) ->
   (AdaptiveWorkflow) query;
  getAgent: (id: text) -> (opt Agent) query;
  getAgents: () -> (vec Agent) query;
  getAgentsByEngine: (engine: text) -> (vec Agent) query;
  getAgentsByProtocol: (protocol: text) -> (vec Agent) query;
  getAgentsByWorkspace: (workspace: text) -> (vec Agent) query;
  getAlignments: (standardCode: StandardCode) ->
   (vec StandardAlignment) query;
  getAllBuilderStats: () -> (vec record {
                                   text;
                                   BuilderStats;
                                 }) query;
  getAllMoodAggregates: () -> (vec MoodAggregate) query;
  getAllRecognitionFlags: () -> (vec RecognitionFlag) query;
  getAllSubjects: () -> (vec Subject) query;
  getAllocatorStats: () -> (AllocatorStats) query;
  getAnnouncementsBySchool: (schoolId: nat) -> (vec CommMessage) query;
  getApiCallLogs: (n: nat) -> (vec ApiCallLog) query;
  getApiEndpointById: (id: text) -> (opt ApiEndpoint) query;
  getApiEndpoints: () -> (vec ApiEndpoint) query;
  getApiEndpointsByDomain: (domain: text) -> (vec ApiEndpoint) query;
  getApiStats: () -> (ApiStats) query;
  getApiUsageStats: (clientId: text) -> (opt ApiUsageStats) query;
  getApiVersions: () -> (vec ApiVersion) query;
  getAsgnStats: () -> (AsgnStats) query;
  getAssignment: (id: nat) -> (opt Assignment) query;
  getAssignmentsByClass: (classCode: text) -> (vec Assignment) query;
  getAttendance: (sisId: SisStudentId) -> (vec AttendanceRecord) query;
  getBuilderStats: (builderId: text) -> (opt BuilderStats) query;
  getCalendarEvents: (schoolId: nat) -> (vec CalendarEvent) query;
  getCatalog: () -> (vec CatalogCourse) query;
  getCheckoutsByStudent: (studentPrincipal: principal) ->
