      ("ela",       "English Language Arts"),
      ("math",      "Mathematics"),
      ("science",   "Science"),
      ("socialstudies", "Social Studies"),
      ("geography", "Geography"),
      ("art",       "Art"),
      ("music",     "Music"),
      ("pe",        "Physical Education"),
      ("cs",        "Computer Science"),
      ("spanish",   "Foreign Language (Spanish)"),
      ("health",    "Health & Wellness"),
      ("electives", "Electives: Critical Thinking & Logic"),
    ];
    for (grade in grades.values()) {
      for ((subKey, subName) in subjectDefs.values()) {
        let subId = grade # "-" # subKey;
        subjects.add(subId, { id = subId; name = subName; gradeLevel = grade });
      };
    };

