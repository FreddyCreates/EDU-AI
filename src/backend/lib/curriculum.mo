    for ((topicId, subjectId, title) in topicData.values()) {
      let gradeLevel = if (subjectId.size() > 0) {
        var g = "";
        label lp for (c in subjectId.chars()) {
          if (c == '-') { break lp };
          g #= ("" # c.toText());
        }; // lp
        g;
      } else { "" };
      topics.add(topicId, {
        id = topicId;
        subjectId = subjectId;
        title = title;
        description = title # " — TEKS-aligned topic for grade " # gradeLevel;
        gradeLevel = gradeLevel;
      });
    };
  };

  // getAllSubjects — returns one Subject record per unique subject type (12 unique subjects),
  // using the grade-K record for each. Used by Dashboard for logged-out users.
  public func getAllSubjects(subjects : SubjectStore) : [Types.Subject] {
    let seen = List.empty<Text>();
    let buf = List.empty<Types.Subject>();
    for ((_, s) in subjects.entries()) {
      // Derive subject key: everything after the first "-" in the id (e.g. "K-math" → "math")
      var subKey = "";
      var pastDash = false;
      for (c in s.id.chars()) {
        if (pastDash) {
          subKey #= c.toText();
        } else if (c == '-') {
          pastDash := true;
        };
      };
      if (not seen.any(func(k) { k == subKey })) {
        seen.add(subKey);
        buf.add(s);
      };
    };
    buf.toArray()
  };

  public func getSubjectsByGrade(
    subjects : SubjectStore,
    gradeLevel : Text,
  ) : [Types.Subject] {
    // When gradeLevel is empty, return all 12 unique subjects (one per type)
    if (gradeLevel.size() == 0) {
      return getAllSubjects(subjects);
    };
    let buf = List.empty<Types.Subject>();
    for ((_, s) in subjects.entries()) {
      if (s.gradeLevel == gradeLevel) {
        buf.add(s);
      };
    };
    buf.toArray();
  };

  public func getTopicsBySubject(
    topics : TopicStore,
    subjectId : Text,
  ) : [Types.Topic] {
    let buf = List.empty<Types.Topic>();
    for ((_, t) in topics.entries()) {
      if (t.subjectId == subjectId) {
        buf.add(t);
      };
    };
    buf.toArray();
  };
};
